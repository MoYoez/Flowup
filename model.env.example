# Configuration reference: set these variables in your shell.
# Flowup does not automatically load model.env or .env files.
# Used by `ai.generate` (non-streaming structured output, no tools).

OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com
# Required when a workflow uses `model: default`.
FLOWUP_AI_MODEL=gpt-4o-mini

# Optional: comma-separated host allowlist for http.request.
# FLOWUP_ALLOWED_HOSTS=api.github.com,slack.com
# Optional: set to 1 to allow http.request to reach private/loopback addresses
# (off by default to prevent SSRF). Only enable for trusted local testing.
# FLOWUP_ALLOW_PRIVATE_NETWORK=0
