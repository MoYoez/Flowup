# Flowup model config template — copy to `model.env` and fill in (model.env is gitignored).
#
#   cp model.env.example model.env   # then edit
#   set -a; source model.env; set +a
#   go run ./cmd/flowup run <pipeline.yaml> --params '{...}'
#
# FLOWUP_MODEL selects the adapter: "openai" (any OpenAI-compatible endpoint:
# OpenAI, vLLM, llama.cpp, Ollama, a proxy) or "anthropic". Unset = no model
# (semantic/agent nodes fail with model_runner_not_configured; native nodes still run).

FLOWUP_MODEL=openai
OPENAI_BASE_URL=https://your-host:8000
OPENAI_API_KEY=sk-...
OPENAI_MODEL=your-model-name

# For Anthropic instead:
# FLOWUP_MODEL=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
