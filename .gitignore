# build output
/bin/
*.exe

# local durable state (SQLite event store / state projection)
*.db
*.db-shm
*.db-wal
/.flowup/
/tmp/
/.worktrees/

# scratch pipelines generated by `flowup new` at the repo root (real ones live in examples/)
/*.pipeline.yaml

# secrets / local model config (keep the .example, ignore the real one)
*.env
!*.env.example

# go
go.work
go.work.sum

# test / coverage artifacts
*.out
coverage.*
*.test

# editor / OS
.idea/
.vscode/
.DS_Store
